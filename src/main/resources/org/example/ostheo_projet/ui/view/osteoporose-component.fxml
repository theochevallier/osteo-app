<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>

<?import javafx.scene.layout.HBox?>
<fx:root type="HBox" spacing="12" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" alignment="CENTER_LEFT" >

    <HBox alignment="CENTER">
        <Button fx:id="btnCancel" onAction="#handleClicCancel" styleClass="osteoporose-button, cancel-button" style="-fx-border-radius: 8 0 0 8; -fx-background-radius: 8 0 0 8;"/>
        <Button fx:id="btn1" onAction="#handleClicBtn1" styleClass="osteoporose-button, green-button" />
        <Button fx:id="btn2" onAction="#handleClicBtn2" styleClass="osteoporose-button, yellow-button" />
        <Button fx:id="btn3" onAction="#handleClicBtn3" styleClass="osteoporose-button, red-button" style="-fx-border-radius: 0 8 8 0; -fx-background-radius: 0 8 8 0;" />
    </HBox>

    <Label text="Ostéoporose" style="-fx-font-weight: normal; -fx-font-size: 13;"/>
</fx:root>
