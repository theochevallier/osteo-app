<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import org.example.ostheo_projet.ui.component.AutoCompleteTextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.geometry.Insets?>


<!-- Pane consultation inputs -->
<fx:root type="VBox" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">

        <VBox>

            <VBox fx:id="cardConsultationInfos" spacing="16" style="-fx-padding: 20;">
                <HBox alignment="TOP_CENTER">
                    <Button styleClass="yellow-button" text="Modifier" visible="false"/>
                    <Region HBox.hgrow="ALWAYS"/>

                    <Label fx:id="lblTitlePage" styleClass="label-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="btnModifyConsult" styleClass="yellow-button" text="Modifier"
                            onAction="#handleUpdateConsult" visible="false"/>
                </HBox>

                <!-- EDIT PANE -->
                <VBox fx:id="paneEdit" spacing="16">
                    <!-- Origin of the consultation -->
                    <VBox styleClass="card" spacing="10">
                        <Label text="Origine de la consultation"
                               style="-fx-font-weight: bold; -fx-font-size: 16;"/>
                        <Region HBox.hgrow="ALWAYS"/>

                        <!-- Date and reason -->
                        <VBox spacing="30">
                            <VBox spacing="6">
                                <Label text="Date de consultation" styleClass="label"/>
                                <TextField fx:id="inputDateConsult" promptText="jj/mm/aaaa" maxWidth="110"/>
                            </VBox>
                            <VBox spacing="6" VBox.vgrow="ALWAYS">
                                <Label text="Raison" styleClass="label"/>
                                <TextArea fx:id="inputReasonConsult" wrapText="true" prefHeight="110"/>
                            </VBox>
                        </VBox>
                    </VBox>

                    <!-- TRAITEMENT -->
                    <VBox styleClass="card" spacing="15">
                        <Label text="Traitement"
                               style="-fx-font-weight: bold; -fx-font-size: 16;"/>
                        <Region HBox.hgrow="ALWAYS"/>

                        <!-- Treatment and medical exam -->
                        <HBox spacing="25">
                            <VBox spacing="6" HBox.hgrow="ALWAYS">
                                <Label text="Traitement réalisé" styleClass="label"/>
                                <TextArea fx:id="inputTreatmentConsult" wrapText="true" prefHeight="110"/>
                            </VBox>
                            <VBox spacing="6" HBox.hgrow="ALWAYS">
                                <Label text="Examen médical" styleClass="label"/>
                                <TextArea fx:id="inputMedicalExamConsult" wrapText="true" prefHeight="110"/>
                            </VBox>
                        </HBox>

                        <!-- Exclusion test, food supplement -->
                        <HBox spacing="25">
                            <VBox spacing="6" HBox.hgrow="ALWAYS">
                                <Label text="Tests d'exclusion" styleClass="label"/>
                                <TextArea fx:id="inputExclusionTestConsult" wrapText="true" prefHeight="110"/>
                            </VBox>
                            <VBox spacing="6" HBox.hgrow="ALWAYS">
                                <Label text="Compléments alimentaires" styleClass="label"/>
                                <TextArea fx:id="inputFoodSuppConsult" wrapText="true" prefHeight="110"/>
                            </VBox>
                        </HBox>
                    </VBox>

                    <!-- ADVICES -->
                    <VBox styleClass="card" spacing="10">
                        <Label text="Conseils"
                               style="-fx-font-weight: bold; -fx-font-size: 16;"/>
                        <Region HBox.hgrow="ALWAYS"/>

                        <!-- given advices and exercises -->
                        <HBox spacing="20">
                            <VBox spacing="6" HBox.hgrow="ALWAYS">
                                <Label text="Conseils donnés" styleClass="label"/>
                                <TextArea fx:id="inputGivenAdvicesConsult" wrapText="true" prefHeight="110"/>
                            </VBox>
                            <VBox spacing="6" HBox.hgrow="ALWAYS">
                                <Label text="Exercices à réaliser" styleClass="label"/>
                                <TextArea fx:id="inputGivenExercisesConsult" wrapText="true" prefHeight="110"/>
                            </VBox>
                        </HBox>
                    </VBox>

                    <!-- READRESSAGE -->
                    <VBox styleClass="card" spacing="10">
                        <Label text="Réadressage d'un professionnel de santé"
                               style="-fx-font-weight: bold; -fx-font-size: 16;"/>
                        <Region HBox.hgrow="ALWAYS"/>

                        <FlowPane hgap="20" vgap="20">
                            <CheckBox fx:id="checkDoctorRelocEdit" text="Médecin" styleClass="check-relocation"/>
                            <CheckBox fx:id="checkDentistRelocEdit" text="Dentiste" styleClass="check-relocation"/>
                            <CheckBox fx:id="checkOrthophonistRelocEdit" text="Orthophoniste"
                                      styleClass="check-relocation"/>
                            <CheckBox fx:id="checkOrthodontistRelocEdit" text="Orthodontiste"
                                      styleClass="check-relocation"/>
                            <CheckBox fx:id="checkOrthoptistRelocEdit" text="Orthoptiste"
                                      styleClass="check-relocation"/>
                            <CheckBox fx:id="checkPodologueRelocEdit" text="Podologue" styleClass="check-relocation"/>
                            <CheckBox fx:id="checkIBCLCRelocEdit" text="IBCLC" styleClass="check-relocation"/>
                        </FlowPane>

                        <VBox spacing="6">
                            <Label text="Commentaire" styleClass="label"/>
                            <TextArea fx:id="inputRelocationConsult" prefHeight="110" wrapText="true"/>
                        </VBox>
                    </VBox>

                    <!-- NOTES -->
                    <VBox styleClass="card" spacing="10">
                        <Label text="Notes personnelles"
                               style="-fx-font-weight: bold; -fx-font-size: 16;"/>
                        <Region HBox.hgrow="ALWAYS"/>

                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <TextArea fx:id="inputNotesConsult" wrapText="true" prefWidth="110"/>
                        </VBox>
                    </VBox>

                    <!-- JOINED FILES -->
                    <VBox styleClass="card" spacing="10">
                        <HBox spacing="10">
                            <Label text="Fichiers à joindre"
                                   style="-fx-font-weight: bold; -fx-font-size: 16;"/>
                            <Region HBox.hgrow="ALWAYS"/>

                            <Button fx:id="btnOpenFolder" text="Choisir" styleClass="blue-button"
                                    onAction="#handleChooseFile"/>
                        </HBox>

                        <FlowPane fx:id="conteneurSelectedFilesEdit" hgap="20" vgap="20">
                        </FlowPane>
                    </VBox>

                </VBox>


                <!-- SHOW PANE -->
                <VBox fx:id="paneShow" spacing="16">
                    <!-- Origin of the consultation -->
                    <VBox styleClass="card" spacing="10">
                        <Label text="Origine de la consultation" styleClass="label-of-value"
                               style="-fx-font-weight: bold; -fx-font-size: 16;"/>
                        <Region HBox.hgrow="ALWAYS"/>

                        <!-- Date and reason -->
                        <HBox spacing="30">
                            <VBox spacing="6" minWidth="140">
                                <Label text="Date de consultation" styleClass="label-of-value"/>
                                <Label fx:id="lblDateConsult" styleClass="label-value"/>
                            </VBox>
                            <VBox spacing="6" HBox.hgrow="ALWAYS">
                                <Label text="Raison" styleClass="label-of-value"/>
                                <Label fx:id="lblReasonConsult" wrapText="true" styleClass="label-value" />
                            </VBox>
                        </HBox>
                    </VBox>

                    <!-- TRAITEMENT -->
                    <VBox styleClass="card" spacing="15">
                        <Label text="Traitement" styleClass="label-of-value"
                               style="-fx-font-weight: bold; -fx-font-size: 16;"/>
                        <Region HBox.hgrow="ALWAYS"/>

                        <GridPane fx:id="gridPaneShowHealthForm" hgap="30" vgap="30">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="50.0"/>
                                <ColumnConstraints percentWidth="50.0"/>
                            </columnConstraints>
                            <rowConstraints>
                            </rowConstraints>
                            <children>
                                <!-- Treatment and medical exam -->
                                <VBox spacing="6" HBox.hgrow="ALWAYS" GridPane.columnIndex="0"
                                      GridPane.rowIndex="0">
                                    <Label text="Traitement réalisé" styleClass="label-of-value"/>
                                    <Label fx:id="lblTreatmentConsult" wrapText="true" styleClass="label-value"/>
                                </VBox>

                                <VBox spacing="6" HBox.hgrow="ALWAYS" GridPane.columnIndex="1"
                                      GridPane.rowIndex="0">
                                    <Label text="Examen médical" styleClass="label-of-value"/>
                                    <Label fx:id="lblMedicalExamConsult" wrapText="true" styleClass="label-value"/>
                                </VBox>

                                <!-- Exclusion test, food supplement -->
                                <VBox spacing="6" HBox.hgrow="ALWAYS" GridPane.columnIndex="0"
                                      GridPane.rowIndex="1">
                                    <Label text="Tests d'exclusion" styleClass="label-of-value"/>
                                    <Label fx:id="lblExclusionTestConsult" wrapText="true"
                                           styleClass="label-value"/>
                                </VBox>

                                <VBox spacing="6" HBox.hgrow="ALWAYS" GridPane.columnIndex="1"
                                      GridPane.rowIndex="1">
                                    <Label text="Compléments alimentaires" styleClass="label-of-value"/>
                                    <Label fx:id="lblFoodSuppConsult" wrapText="true" styleClass="label-value"/>
                                </VBox>
                            </children>
                        </GridPane>
                    </VBox>

                    <!-- ADVICES -->
                    <VBox styleClass="card" spacing="10">
                        <Label text="Conseils" styleClass="label-of-value"
                               style="-fx-font-weight: bold; -fx-font-size: 16;"/>
                        <Region HBox.hgrow="ALWAYS"/>

                        <!-- given advices and exercises -->
                        <GridPane hgap="30" vgap="30">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="50.0"/>
                                <ColumnConstraints percentWidth="50.0"/>
                            </columnConstraints>
                            <rowConstraints>
                            </rowConstraints>
                            <children>
                                <VBox spacing="6" HBox.hgrow="ALWAYS" GridPane.columnIndex="0"
                                      GridPane.rowIndex="0">
                                    <Label text="Conseils donnés" styleClass="label-of-value"/>
                                    <Label fx:id="lblGivenAdvicesConsult" wrapText="true" styleClass="label-value"/>
                                </VBox>
                                <VBox spacing="6" HBox.hgrow="ALWAYS" GridPane.columnIndex="1"
                                      GridPane.rowIndex="0">
                                    <Label text="Exercices à réaliser" styleClass="label-of-value"/>
                                    <Label fx:id="lblGivenExercisesConsult" wrapText="true"
                                           styleClass="label-value"/>
                                </VBox>
                            </children>
                        </GridPane>
                    </VBox>

                    <!-- READRESSAGE -->
                    <VBox styleClass="card" spacing="10">
                        <Label text="Réadressage d'un professionnel de santé" styleClass="label-of-value"
                               style="-fx-font-weight: bold; -fx-font-size: 16;"/>
                        <Region HBox.hgrow="ALWAYS"/>

                        <FlowPane hgap="20" vgap="20">
                            <CheckBox fx:id="checkDoctorRelocShow" text="Médecin" styleClass="check-relocation"
                                      mouseTransparent="true" focusTraversable="false"/>
                            <CheckBox fx:id="checkDentistRelocShow" text="Dentiste" styleClass="check-relocation"
                                      mouseTransparent="true" focusTraversable="false"/>
                            <CheckBox fx:id="checkOrthophonistRelocShow" text="Orthophoniste"
                                      styleClass="check-relocation"
                                      mouseTransparent="true" focusTraversable="false"/>
                            <CheckBox fx:id="checkOrthodontistRelocShow" text="Orthodontiste"
                                      styleClass="check-relocation"
                                      mouseTransparent="true" focusTraversable="false"/>
                            <CheckBox fx:id="checkOrthoptistRelocShow" text="Orthoptiste" styleClass="check-relocation"
                                      mouseTransparent="true" focusTraversable="false"/>
                            <CheckBox fx:id="checkPodologueRelocShow" text="Podologue" styleClass="check-relocation"
                                      mouseTransparent="true" focusTraversable="false"/>
                            <CheckBox fx:id="checkIBCLCRelocShow" text="IBCLC" styleClass="check-relocation"
                                      mouseTransparent="true" focusTraversable="false"/>
                        </FlowPane>

                        <VBox spacing="6">
                            <Label text="Commentaire" styleClass="label-of-value"/>
                            <Label fx:id="lblRelocationConsult" styleClass="label-value" wrapText="true"/>
                        </VBox>
                    </VBox>

                    <!-- NOTES -->
                    <VBox styleClass="card" spacing="10">
                        <Label text="Notes personnelles" styleClass="label-of-value"
                               style="-fx-font-weight: bold; -fx-font-size: 16;"/>
                        <Region HBox.hgrow="ALWAYS"/>

                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <!--            <Label text="Examen médical" styleClass="label"/>-->
                            <Label fx:id="lblNotesConsult" wrapText="true" styleClass="label-value"/>
                        </VBox>
                    </VBox>

                    <!-- JOINED FILES -->
                    <VBox styleClass="card" spacing="10">
                        <HBox spacing="10">
                            <Label text="Fichiers joints" styleClass="label-of-value"
                                   style="-fx-font-weight: bold; -fx-font-size: 16;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                        </HBox>

                        <FlowPane fx:id="conteneurSelectedFilesShow" hgap="20" vgap="20">
                        </FlowPane>
                    </VBox>

                    <VBox.margin>
                        <Insets bottom="30"/>
                    </VBox.margin>

                    <VBox.margin>
                        <Insets bottom="50"/>
                    </VBox.margin>
                </VBox>
            </VBox>

            <!-- ACTION BUTTONS -->
            <HBox fx:id="paneActionButtons" alignment="BOTTOM_RIGHT" spacing="10" visible="false" >
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Annuler" styleClass="cancel-button" onAction="#handleCancelModifyConsult"/>
                <Button text="Enregistrer" styleClass="blue-button" onAction="#handleSaveConsult"/>
            </HBox>

        </VBox>
</fx:root>